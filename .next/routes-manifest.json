    },
    {
      "page": "/admin/session-monitoring/rtsm",
      "regex": "^/admin/session\\-monitoring/rtsm(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin/session\\-monitoring/rtsm(?:/)?$"
    },
    {
