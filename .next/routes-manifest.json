      "namedRegex": "^/home(?:/)?$"
    },
    {
      "page": "/linux-passwordbased",
      "regex": "^/linux\\-passwordbased(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/linux\\-passwordbased(?:/)?$"
    },
    {
